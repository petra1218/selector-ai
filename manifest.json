{
  "manifest_version": 3,
  "name": "Browser Extension Selector",
  "description": "Minimal MV3 shell for launching the selector runtime.",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Start Selector"
  },
  "commands": {
    "open-selector-popup": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Open the Selector popup"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
